# SpamHop listener presented to the mail client.
SPAMHOP_PORT=1143
SPAMHOP_CLIENT_USERNAME=your-spamhop-login
SPAMHOP_CLIENT_PASSWORD=change-me

# Authoritative upstream IMAP server.
SPAMHOP_UPSTREAM=imap.example.com:993
SPAMHOP_UPSTREAM_TLS=implicit
SPAMHOP_UPSTREAM_USERNAME=you@example.com
SPAMHOP_UPSTREAM_PASSWORD=change-me

# Replaceable scoring processor.
SPAMHOP_PROCESSOR=spamhop.processor.spam:Processor

# SpamHop owns the final policy threshold. The LLM does not decide spam/ham.
SPAMHOP_SPAM_THRESHOLD=0.70

# Rspamd contributes signed technical evidence to the final SpamHop score.
SPAMHOP_RSPAMD_ENABLED=true
SPAMHOP_RSPAMD_URL=http://rspamd:11333
SPAMHOP_RSPAMD_TIMEOUT_SECONDS=15
# tanh(raw_rspamd_score / scale) normalizes Rspamd's signed raw score.
SPAMHOP_RSPAMD_SCORE_SCALE=6.0
# Maximum amount Rspamd may add to or subtract from the semantic score.
SPAMHOP_RSPAMD_MAX_ADJUSTMENT=0.30

# LLM provider. Ollama is the initial provider implementation.
# From Docker on Linux, host.docker.internal reaches Ollama on the laptop host.
SPAMHOP_LLM_PROVIDER=ollama
SPAMHOP_LLM_BASE_URL=http://host.docker.internal:11434
SPAMHOP_LLM_API_KEY=
SPAMHOP_LLM_MODEL=your-installed-model
SPAMHOP_LLM_TIMEOUT_SECONDS=120
SPAMHOP_LLM_MAX_BYTES=65536

# Prompt is configuration, not application code.
SPAMHOP_PROMPT_FILE=/app/config/spam-prompt.txt

# Optional review UI and seven-day training mode (localhost:8088).
# Training mode captures scored RFC822 messages for seven days only.
# Original scores and human feedback remain as metadata after expiry.
SPAMHOP_REVIEW_ENABLED=false
SPAMHOP_TRAINING_ENABLED=false
SPAMHOP_TRAINING_MAX_MESSAGE_BYTES=26214400
SPAMHOP_REVIEW_PORT=8088
SPAMHOP_REVIEW_USER=review
SPAMHOP_REVIEW_PASSWORD=
SPAMHOP_REVIEW_RSPAMD_PASSWORD=
